<Window x:Class="Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Companion"
        Width="160" Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Background="Transparent">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="FollowItem" Header="Follow cursor"
                          IsCheckable="True" IsChecked="True"
                          Click="FollowItem_Click" />
                <Separator />
                <MenuItem Header="Quit" Click="Quit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!--
            PLACEHOLDER CHARACTER drawn with shapes so the app runs with zero art.
            When the real sprites exist, replace everything inside this Canvas
            with an <Image> and swap the Source per state.
            Canvas is 160 x 180. RenderTransformOrigin 0.5,1 = anchored at his feet,
            so squashing/flipping happens around the ground, not the middle.
        -->
        <Canvas x:Name="Character" Width="160" Height="180"
                RenderTransformOrigin="0.5,1">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="Pose" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="Shift" X="0" Y="0" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Ground shadow -->
            <Ellipse Canvas.Left="38" Canvas.Top="158" Width="84" Height="14" Fill="#33000000" />

            <!-- Legs -->
            <Rectangle Canvas.Left="58" Canvas.Top="122" Width="20" Height="36" RadiusX="7" RadiusY="7" Fill="#2B2F3A" />
            <Rectangle Canvas.Left="82" Canvas.Top="122" Width="20" Height="36" RadiusX="7" RadiusY="7" Fill="#2B2F3A" />

            <!-- Braids (behind head) -->
            <Rectangle Canvas.Left="39" Canvas.Top="26" Width="7" Height="46" RadiusX="3.5" RadiusY="3.5" Fill="#1A1410" />
            <Rectangle Canvas.Left="47" Canvas.Top="30" Width="7" Height="54" RadiusX="3.5" RadiusY="3.5" Fill="#1A1410" />
            <Rectangle Canvas.Left="114" Canvas.Top="26" Width="7" Height="46" RadiusX="3.5" RadiusY="3.5" Fill="#1A1410" />
            <Rectangle Canvas.Left="106" Canvas.Top="30" Width="7" Height="54" RadiusX="3.5" RadiusY="3.5" Fill="#1A1410" />

            <!-- Torso: broad shoulders tapering to the waist (tank top) -->
            <Path Fill="#1F8A70" Data="M 44,72 L 116,72 L 102,128 L 58,128 Z" />

            <!-- Arms (thick). Rotated around the shoulder for the walk swing. -->
            <Rectangle x:Name="LeftArm" Canvas.Left="24" Canvas.Top="72" Width="24" Height="54"
                       RadiusX="11" RadiusY="11" Fill="#6F4529" RenderTransformOrigin="0.5,0.1">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="LeftArmRot" Angle="0" />
                </Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle x:Name="RightArm" Canvas.Left="112" Canvas.Top="72" Width="24" Height="54"
                       RadiusX="11" RadiusY="11" Fill="#6F4529" RenderTransformOrigin="0.5,0.1">
                <Rectangle.RenderTransform>
                    <RotateTransform x:Name="RightArmRot" Angle="0" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- Neck + head -->
            <Rectangle Canvas.Left="71" Canvas.Top="58" Width="18" Height="18" Fill="#6F4529" />
            <Ellipse Canvas.Left="52" Canvas.Top="14" Width="56" Height="56" Fill="#6F4529" />

            <!-- Hair cap over the top of the head -->
            <Ellipse Canvas.Left="49" Canvas.Top="8" Width="62" Height="36" Fill="#1A1410" />

            <!-- Eyes + smile -->
            <Ellipse Canvas.Left="66" Canvas.Top="46" Width="7" Height="9" Fill="#111111" />
            <Ellipse Canvas.Left="87" Canvas.Top="46" Width="7" Height="9" Fill="#111111" />
            <Path Stroke="#3A1F10" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 70,59 Q 80,66 90,59" />
        </Canvas>
    </Grid>
</Window>
